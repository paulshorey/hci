# Run pnpm setup:local to create an ignored .env with a random secret.
DATABASE_URL=postgresql://hci:hci@127.0.0.1:55432/hci
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
SITE_URL=http://localhost:4500
EMBED_ORIGIN=http://localhost:4501
EMBED_PORT=4501
EMBED_PREVIEW_SECRET=replace-with-another-32-random-characters
STORAGE_DRIVER=disk
STORAGE_DIR=./storage
# Set STORAGE_DRIVER=s3 for Railway Buckets or AWS S3.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional SMTP transport for CMS password recovery. No emails/tokens are logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=The field journal
# Tests must use a separate disposable database, never DATABASE_URL.
HCI_TEST_DATABASE_URL=postgresql://hci:hci@127.0.0.1:55432/hci_test
