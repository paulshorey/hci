# Run pnpm setup:local to create an ignored .env with a random secret.
DATABASE_URL=postgresql://hci:hci@127.0.0.1:55432/hci
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
SITE_URL=http://localhost:4500
EMBED_ORIGIN=http://localhost:4501
EMBED_PORT=4501
EMBED_PREVIEW_SECRET=replace-with-another-32-random-characters
STORAGE_DRIVER=disk
STORAGE_DIR=./storage
# Deployment uses private Railway Buckets with STORAGE_DRIVER=s3.
# For local access to a bucket, copy its exact Credentials values into this ignored .env.
# Use BUCKET (the S3 name), base ENDPOINT and signing REGION, not the display name/placement region.
# New Railway buckets use virtual-hosted URLs (path style=false); check Credentials for older buckets.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public file delivery uses five-minute signed bucket URLs. Editor previews remain proxied.
S3_SIGNED_DOWNLOADS=true
# Per-file server upload limit, 1–500 MiB. Default 100. Use managed video for large recordings.
MEDIA_MAX_UPLOAD_MB=100
# Optional SMTP transport for CMS password recovery. No emails/tokens are logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=The field journal
# Tests must use a separate disposable database, never DATABASE_URL.
HCI_TEST_DATABASE_URL=postgresql://hci:hci@127.0.0.1:55432/hci_test
