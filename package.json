{
  "name": "hci-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.16 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4500",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-4500}",
    "payload": "payload",
    "generate:types": "payload generate:types && payload generate:db-schema",
    "db:migration:create": "payload migrate:create",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "payload migrate:status",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:snapshot": "tsx scripts/snapshot-db.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "seed": "tsx scripts/seed.ts",
    "snippets:import": "tsx scripts/import-snippet.ts",
    "storage:check": "tsx scripts/check-storage.ts",
    "embeds:dev": "tsx watch services/embeds/server.ts",
    "embeds:start": "tsx services/embeds/server.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-force-exit --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/libre-caslon-display": "5.3.0",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "dotenv": "18.0.8",
    "graphql": "16.14.2",
    "mime-types": "3.0.2",
    "next": "16.4.2",
    "payload": "3.91.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/mime-types": "3.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "railway": "3.16.0",
    "typescript": "5.9.3"
  }
}
